    "This permanently deletes your account and all associated data. This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Detta raderar ditt konto och all tillhörande data permanent. Det går inte att ångra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dadurch werden dein Account und alle zugehörigen Daten dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre compte et toutes les données associées seront définitivement supprimés. Cette action est irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esto elimina de forma permanente tu cuenta y todos los datos asociados. No se puede deshacer."
