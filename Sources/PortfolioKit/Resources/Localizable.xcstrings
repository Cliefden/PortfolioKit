    "Delete your account? This can't be undone.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Radera ditt konto? Det går inte att ångra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Account löschen? Dies kann nicht rückgängig gemacht werden."
