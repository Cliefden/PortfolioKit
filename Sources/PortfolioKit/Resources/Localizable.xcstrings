    "Delete your account? This can't be undone.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Radera ditt konto? Det går inte att ångra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Account löschen? Dies kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Supprimer votre compte ? Cette action est irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Eliminar tu cuenta? No se puede deshacer."
          }
        }
      }
    },
    "Deleting your account does not cancel an App Store subscription. Cancel it separately in Settings ▸ your name ▸ Subscriptions.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Att radera kontot avslutar inte en App Store-prenumeration. Avsluta den separat i Inställningar ▸ ditt namn ▸ Prenumerationer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Löschen deines Accounts kündigt kein App Store-Abo. Kündige es separat unter Einstellungen ▸ dein Name ▸ Abonnements."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La suppression de votre compte ne résilie pas un abonnement App Store. Résiliez-le séparément dans Réglages ▸ votre nom ▸ Abonnements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eliminar tu cuenta no cancela una suscripción del App Store. Cancélala por separado en Ajustes ▸ tu nombre ▸ Suscripciones."
          }
        }
      }
    },
