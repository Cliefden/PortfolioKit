    "Deleting your account does not cancel an App Store subscription. Cancel it separately in Settings ▸ your name ▸ Subscriptions.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Att radera kontot avslutar inte en App Store-prenumeration. Avsluta den separat i Inställningar ▸ ditt namn ▸ Prenumerationer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Löschen deines Accounts kündigt kein App Store-Abo. Kündige es separat unter Einstellungen ▸ dein Name ▸ Abonnements."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La suppression de votre compte ne résilie pas un abonnement App Store. Résiliez-le séparément dans Réglages ▸ votre nom ▸ Abonnements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eliminar tu cuenta no cancela una suscripción del App Store. Cancélala por separado en Ajustes ▸ tu nombre ▸ Suscripciones."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حذف حسابك لا يلغي اشتراك App Store. ألغِه بشكل منفصل من الإعدادات ▸ اسمك ▸ الاشتراكات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sletning af din konto opsiger ikke et App Store-abonnement. Opsig det separat under Indstillinger ▸ dit navn ▸ Abonnementer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’eliminazione dell’account non annulla un abbonamento App Store. Annullalo separatamente in Impostazioni ▸ il tuo nome ▸ Abbonamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アカウントを削除しても App Store のサブスクリプションは解約されません。「設定」▸ ユーザ名 ▸「サブスクリプション」で別途解約してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "계정을 삭제해도 App Store 구독은 취소되지 않습니다. 설정 ▸ 사용자 이름 ▸ 구독에서 별도로 취소하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Å slette kontoen avslutter ikke et App Store-abonnement. Avslutt det separat i Innstillinger ▸ navnet ditt ▸ Abonnementer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Als je je account verwijdert, wordt een App Store-abonnement niet opgezegd. Zeg het apart op via Instellingen ▸ je naam ▸ Abonnementen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usunięcie konta nie anuluje subskrypcji App Store. Anuluj ją osobno w Ustawieniach ▸ Twoje imię i nazwisko ▸ Subskrypcje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apagar sua conta não cancela uma assinatura da App Store. Cancele-a separadamente em Ajustes ▸ seu nome ▸ Assinaturas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Удаление аккаунта не отменяет подписку App Store. Отмените её отдельно в «Настройки» ▸ ваше имя ▸ «Подписки»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "删除账户不会取消 App Store 订阅。请在“设置”▸ 你的姓名 ▸“订阅”中单独取消。"
          }
        }
      }
